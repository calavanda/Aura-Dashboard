{
  "name": "aura-pms",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "app:dev": "cross-env NODE_ENV=development electron .",
    "app:dist": "electron-builder --win"
  },
  "dependencies": {
    "@clerk/localizations": "^4.3.0",
    "@clerk/nextjs": "^7.0.6",
    "@prisma/client": "^6.19.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-particles": "^2.12.2",
    "tailwind-merge": "^3.5.0",
    "tsparticles": "^3.9.1",
    "tsparticles-slim": "^2.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.aura.dashboard",
    "productName": "Aura Dashboard",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aura Dashboard"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ]
  }
}
