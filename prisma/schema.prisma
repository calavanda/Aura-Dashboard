// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  RESERVADOR
  CAJERO
  MESERO
  COCINERO
}

enum RoomStatus {
  Limpia
  Sucia
  Ocupada
  Mantenimiento
}

enum BusinessMode {
  HOSPITALITY
  GASTRONOMY
}

enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
}

/**
 * Model Hotel: Entidad principal que representa un establecimiento.
 * Actúa como raíz para el multi-tenancy y contiene la configuración modular.
 */
model Hotel {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  type           String // Hotel, Hostal, Vivienda | Restaurante, Bar, Cafetería
  businessMode   BusinessMode     @default(HOSPITALITY)
  logoUrl        String?
  subscription   SubscriptionTier @default(BASIC)
  services       String[] // Amenidades o servicios extra seleccionados durante onboarding
  connectionCode String?          @unique
  trialStartedAt DateTime         @default(now())
  rooms          Room[]
  reservations   Reservation[]
  users          User[]
  restaurants    Restaurant[]
  orders         Order[]
  inventory      InventoryItem[]
  expenses       Expense[]
  devices        Device[]
  showHotelModule  Boolean          @default(true)
  showRestaurantModule Boolean        @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String?    @unique
  email     String     @unique
  role      Role       @default(RESERVADOR)
  hotelId   String?    @db.ObjectId
  hotel     Hotel?     @relation(fields: [hotelId], references: [id])
  logs      AuditLog[]
  createdAt DateTime   @default(now())
}

model Room {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  number    String
  type      String
  price     Float      @default(0)
  status    RoomStatus @default(Limpia)
  hotelId   String     @db.ObjectId
  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum PaymentMethod {
  EN_LINEA
  EFECTIVO
  CARGO_A_HABITACION
  TERMINAL
  TRANSFERENCIA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
  NINGUNO
}

model Reservation {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  guestName       String
  roomNumber      String
  checkIn         DateTime
  checkOut        DateTime?
  status          String // CONFIRMADO, PENDIENTE, CANCELADO
  paymentMethod   PaymentMethod   @default(EFECTIVO)
  paymentStatus   PaymentStatus   @default(PENDIENTE)
  paymentProvider PaymentProvider @default(NINGUNO)
  transactionId   String?
  amount          Float?
  hotelId         String          @db.ObjectId
  hotel           Hotel           @relation(fields: [hotelId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/**
 * Model Restaurant: Entidad para la gestión gastronómica.
 * Puede existir de forma independiente o vinculado a un Hotel.
 */
model Restaurant {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       String // RESTAURANTE, BAR, CAFETERIA
  hotelId    String          @db.ObjectId
  hotel      Hotel           @relation(fields: [hotelId], references: [id])
  categories MenuCategory[]
  inventory  InventoryItem[]
  orders     Order[]
  expenses   Expense[]
  devices    Device[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model MenuCategory {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  items        MenuItem[]
}

model MenuItem {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  categoryId  String                 @db.ObjectId
  category    MenuCategory           @relation(fields: [categoryId], references: [id])
  orders      OrderItem[]
  recipe      MenuRecipeIngredient[]
  available   Boolean                @default(true)
}

model MenuRecipeIngredient {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId      String        @db.ObjectId
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String        @db.ObjectId
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityNeeded  Float // Amount to deduct when this item is ordered
}

model Order {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  hotelId       String        @db.ObjectId
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  restaurantId  String?       @db.ObjectId
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id])
  roomNumber    String? // For "CARGO_A_HABITACION"
  items         OrderItem[]
  total         Float
  status        String // PENDIENTE, PREPARANDO, SERVIDO, PAGADO, CANCELADO
  paymentMethod PaymentMethod @default(EFECTIVO)
  paymentStatus PaymentStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String   @db.ObjectId
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float // Price at the time of order
}

/**
 * Model InventoryItem: Control de existencias e insumos.
 * Soporta alertas de stock bajo y valoración financiera.
 */
model InventoryItem {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  quantity     Float
  unit         String // kg, l, pza, etc.
  threshold    Float                  @default(5)
  hotelId      String                 @db.ObjectId
  hotel        Hotel                  @relation(fields: [hotelId], references: [id])
  restaurantId String?                @db.ObjectId
  restaurant   Restaurant?            @relation(fields: [restaurantId], references: [id])
  price        Float                  @default(0) // Financial cost per unit to assess retained capital
  recipeUsages MenuRecipeIngredient[]
  updatedAt    DateTime               @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

/**
 * Model Expense: Registro de egresos operativos (Luz, Agua, Renta, etc.)
 */
model Expense {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  description  String
  amount       Float
  category     String // LUZ, AGUA, RENTA, NOMINA, INSUMOS, OTROS
  hotelId      String      @db.ObjectId
  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  restaurantId String?     @db.ObjectId
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  date         DateTime    @default(now())
}

model Device {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         String // KDS, TERMINAL, MOBILE, PRINTER
  status       String      @default("ONLINE")
  hotelId      String      @db.ObjectId
  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  restaurantId String?     @db.ObjectId
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  lastSeen     DateTime    @default(now())
}
