// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  RESERVADOR
}

enum RoomStatus {
  Limpia
  Sucia
  Ocupada
  Mantenimiento
}

enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
}

model Hotel {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  type             String           // Hotel, Hostal, Vivienda
  logoUrl          String?
  subscription     SubscriptionTier @default(BASIC)
  connectionCode   String?          @unique
  trialStartedAt   DateTime         @default(now())
  rooms            Room[]
  reservations     Reservation[]
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String     @unique
  email     String     @unique
  role      Role       @default(RESERVADOR)
  hotelId   String?    @db.ObjectId
  hotel     Hotel?     @relation(fields: [hotelId], references: [id])
  logs      AuditLog[]
  createdAt DateTime   @default(now())
}

model Room {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  number    String
  type      String
  status    RoomStatus @default(Limpia)
  hotelId   String     @db.ObjectId
  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum PaymentMethod {
  EN_LINEA
  EFECTIVO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
  NINGUNO
}

model Reservation {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  guestName       String
  roomNumber      String
  checkIn         DateTime
  status          String          // CONFIRMADO, PENDIENTE, CANCELADO
  paymentMethod   PaymentMethod   @default(EFECTIVO)
  paymentStatus   PaymentStatus   @default(PENDIENTE)
  paymentProvider PaymentProvider @default(NINGUNO)
  transactionId   String?
  amount          Float?
  hotelId         String          @db.ObjectId
  hotel           Hotel           @relation(fields: [hotelId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}
