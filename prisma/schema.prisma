// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  RESERVADOR
}

enum RoomStatus {
  Limpia
  Sucia
  Ocupada
  Mantenimiento
}

enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
}

model Hotel {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  type             String           // Hotel, Hostal, Vivienda
  logoUrl          String?
  subscription     SubscriptionTier @default(BASIC)
  connectionCode   String?          @unique
  trialStartedAt   DateTime         @default(now())
  rooms            Room[]
  reservations     Reservation[]
  users            User[]
  restaurants      Restaurant[]
  orders           Order[]
  inventory        InventoryItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String     @unique
  email     String     @unique
  role      Role       @default(RESERVADOR)
  hotelId   String?    @db.ObjectId
  hotel     Hotel?     @relation(fields: [hotelId], references: [id])
  logs      AuditLog[]
  createdAt DateTime   @default(now())
}

model Room {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  number    String
  type      String
  price     Float      @default(0)
  status    RoomStatus @default(Limpia)
  hotelId   String     @db.ObjectId
  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum PaymentMethod {
  EN_LINEA
  EFECTIVO
  CARGO_A_HABITACION
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
  NINGUNO
}

model Reservation {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  guestName       String
  roomNumber      String
  checkIn         DateTime
  checkOut        DateTime?
  status          String          // CONFIRMADO, PENDIENTE, CANCELADO
  paymentMethod   PaymentMethod   @default(EFECTIVO)
  paymentStatus   PaymentStatus   @default(PENDIENTE)
  paymentProvider PaymentProvider @default(NINGUNO)
  transactionId   String?
  amount          Float?
  hotelId         String          @db.ObjectId
  hotel           Hotel           @relation(fields: [hotelId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Restaurant {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String         // RESTAURANTE, BAR, CAFETERIA
  hotelId     String         @db.ObjectId
  hotel       Hotel          @relation(fields: [hotelId], references: [id])
  categories  MenuCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MenuCategory {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  items        MenuItem[]
}

model MenuItem {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  categoryId  String        @db.ObjectId
  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  orders      OrderItem[]
  available   Boolean       @default(true)
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  hotelId         String        @db.ObjectId
  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  roomNumber      String?       // For "CARGO_A_HABITACION"
  items           OrderItem[]
  total           Float
  status          String        // PENDIENTE, PREPARANDO, SERVIDO, PAGADO, CANCELADO
  paymentMethod   PaymentMethod @default(EFECTIVO)
  paymentStatus   PaymentStatus @default(PENDIENTE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String   @db.ObjectId
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float    // Price at the time of order
}

model InventoryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  quantity    Float
  unit        String   // kg, l, pza, etc.
  threshold   Float    @default(5)
  hotelId     String   @db.ObjectId
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}
